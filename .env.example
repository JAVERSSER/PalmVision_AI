# ---- Frontend (exposed to the browser — never put secrets here) ----
# Optional: URL of a separately hosted FastAPI service (see server/README.md).
# Leave empty to use the built-in Vercel function at /api/interpret.
VITE_AI_API_BASE=

# ---- Server-side only (Vercel project env vars / FastAPI .env) ----
# Optional. When set, /api/interpret rewrites rule-based readings into more
# natural prose. Without it the app uses the offline rule engine only.
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5
